# =============================================================================
# My Quick Yummy — frontend environment
# =============================================================================
# Copy this file to `.env` in the same directory:
#
#     cp .env.example .env
#
# WARNING: Create React App inlines every REACT_APP_* variable into the
# JavaScript bundle at BUILD time. Anything here is readable by anyone who
# opens the site. Never put a secret, an API key or a password in this file —
# server-side configuration belongs in backend/.env.
#
# CRA reads this file when the dev server starts, so restart `npm start` after
# any edit. For a production image the value is baked in by `npm run build`
# (docker-compose passes it as the REACT_APP_API_URL build argument).
# =============================================================================

# Base URL of the backend API — scheme and host only, no trailing slash and no
# /api suffix (src/services/api.js appends the paths itself).
#
#   local dev   http://localhost:5000
#   docker      http://localhost:5000     (published from the api container)
#   deployed    https://api.your-domain.com
#
# Optional: src/services/api.js falls back to http://localhost:5000.
# Whatever you set here must also appear in CORS_ORIGIN's counterpart —
# the backend only accepts requests from origins listed in backend/.env.
REACT_APP_API_URL=http://localhost:5000
