# =============================================================================
# My Quick Yummy — backend environment
# =============================================================================
# Copy this file to `.env` in the same directory and fill in real values:
#
#     cp .env.example .env
#
# `.env` is git-ignored; this template is committed. Never put a real secret
# in this file.
#
# backend/config/env.js validates these at boot and throws if a REQUIRED one
# is missing, so a misconfigured deployment fails loudly instead of starting
# up without authentication.
#
# The server reads this file once at startup — restart it after any edit.
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# PORT      optional, default 5000
# NODE_ENV  optional, default development. Set to `production` to stop error
#           responses from including stack traces.
PORT=5000
NODE_ENV=development

# Origins allowed to call this API, comma separated, no trailing slash.
# Anything not listed is refused by the CORS middleware.
#   local dev  ->  http://localhost:3000
#   docker     ->  http://localhost:3000
#   deployed   ->  https://your-domain.com
CORS_ORIGIN=http://localhost:3000


# -----------------------------------------------------------------------------
# Database  (REQUIRED)
# -----------------------------------------------------------------------------
# Pick the form that matches where MongoDB is running. The database name is the
# path segment after the host — `myqymern` below.
#
#   Local mongod          mongodb://127.0.0.1:27017/myqymern
#   docker compose        mongodb://mongo:27017/myqymern
#   MongoDB Atlas         mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/myqymern?retryWrites=true&w=majority
#
# Atlas notes:
#   - The password must be URL-encoded if it contains @ : / ? # [ ] or %.
#   - Your current IP has to be on the cluster's Network Access allow-list, or
#     every connection fails with "Could not connect to any servers".
#   - Free (M0) clusters pause after a period of inactivity and take a few
#     minutes to resume. Connections are refused until the resume completes.
MONGO_URI=mongodb://127.0.0.1:27017/myqymern


# -----------------------------------------------------------------------------
# Customer authentication  (JWT_SECRET is REQUIRED)
# -----------------------------------------------------------------------------
# Signs the tokens the storefront sends as the `auth-token` header.
# Generate one with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters — the server refuses to boot on anything shorter.
JWT_SECRET=

# Optional, default 7d. Accepts zeit/ms strings: 60, "2 days", "10h", "7d".
JWT_EXPIRES_IN=7d


# -----------------------------------------------------------------------------
# Admin console  (all four REQUIRED)
# -----------------------------------------------------------------------------
# The login for http://localhost:3000/admin/login. These are checked server
# side in routes/AdminAuth.js with a constant-time comparison; the browser only
# ever holds the issued token.
ADMIN_EMAIL=admin@myquickyummy.com
ADMIN_PASSWORD=

# IMPORTANT: this MUST be a different value from JWT_SECRET above, and both
# must be at least 32 characters. config/env.js enforces both at boot.
# Admin tokens are signed with their own secret, which is what stops a
# customer token being replayed against an admin route even if its payload
# were forged to claim `role: "admin"`.
ADMIN_JWT_SECRET=

# Optional, default 12h. Shorter than the customer token on purpose.
ADMIN_JWT_EXPIRES_IN=12h
